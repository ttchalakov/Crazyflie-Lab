# scheduler_bench GAP8 app. Built by host/bench.py:
#
#   make NET_DIR=<a network host/sched_net.py generated> SENSOR=QQVGA_BIN2_120 \
#        FORMAT=JPEG STATE_RATE_HZ=100 PHASE_MS=20000 clean build image
#
# NET_DIR holds gap8_app/ (DORY's code) and gen/sched_net.h. The camera, stream
# and scheduler settings are lib/gap8/sched's (see sched.mk); this bench builds
# both schedulers and runs them back to back.

io=uart
PMSIS_OS=freertos
APP = scheduler_bench
APP_SRCS += scheduler_bench.c
APP_INC += .
APP_CFLAGS += -O3 -g

CF_LAB ?= $(abspath $(CURDIR)/../../..)

ifndef NET_DIR
ifneq ($(strip $(MAKECMDGOALS)),clean)
$(error set NET_DIR to a network generated by host/sched_net.py)
endif
endif
DORY_NET_DIR := $(NET_DIR)/gap8_app
include $(CF_LAB)/lib/gap8/dory/dory.mk
DORY_KERNEL_VARIANT ?= pulp_nn
include $(CF_LAB)/lib/gap8/dory/kernels.mk
APP_INC += $(NET_DIR)/gen

SCHED ?= BOTH
SCHED_METRICS ?= 1
SCHED_VERIFY ?= 1
include $(CF_LAB)/lib/gap8/sched/sched.mk

bench_number = $(if $($1),-D$1=$($1))
APP_CFLAGS += $(call bench_number,STATE_RATE_HZ) $(call bench_number,PHASE_MS)
APP_CFLAGS += $(call bench_number,ROUNDS) $(call bench_number,SETTLE_MS)

# On l3 the weights come from the flash filesystem, at the offset the radio
# flasher writes the image to.
ifneq ($(strip $(DORY_NET_HEX)),)
READFS_FILES := $(DORY_NET_HEX)
APP_CFLAGS += -DFS_READ_FS -DFS_PARTITIONTABLE_OFFSET=0x40000
endif

include $(RULES_DIR)/pmsis_rules.mk
